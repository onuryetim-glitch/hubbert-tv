  "kind": "fact",
  "side": "left"
 },
 {
  "scene": 7,
  "anchor": "Sık verilen tahminlere göre, yumurtadan çıkanların",
  "text": "Tahmine göre yavruların\nbinde biri erişkin olur",
  "kind": "fact",
  "side": "left"
 },
 {
  "scene": 7,
  "anchor": "Bir dişinin yumurtalığında yaklaşık üç yüz milyon",
