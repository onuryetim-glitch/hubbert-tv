  "kind": "fact",
  "side": "left"
 },
 {
  "scene": 4,
  "anchor": "Erkek ise yerinde kalıyor.",
  "text": "Erkek yaklaşık 65 gün\nayakta bekliyor",
  "kind": "fact",
  "side": "right"
 },
 {
  "scene": 4,
  "anchor": "Peki ya gecikirse? Erkek, yemek",
  "text": "Dişi gecikirse\nyavru ne yer?",
  "kind": "hook",
  "side": "left"
 },
 {
  "scene": 5,
  "anchor": "\"Erkek hamile kalıyor\" cümlesi büyük oranda",
  "text": "Erkek gerçekten\nhamile mi?",
  "kind": "hook",
  "side": "left"
 },
 {
  "scene": 5,
  "anchor": "Süre türe göre yaklaşık iki",
  "text": "Gebelik: 2-4 hafta\n(türe göre)",
  "kind": "fact",
  "side": "right"
 },
 {
  "scene": 5,
  "anchor": "Bazı türlerde erkek, doğumdan sonraki saatler",
  "text": "Bazı türlerde: doğumdan\nsaatler sonra yeni yumurta",
  "kind": "fact",
  "side": "left"
 },
 {
  "scene": 6,
  "anchor": "Nehir kenarında kuma bir yuva kazıp",
  "text": "Nil timsahı\n25-80 yumurta gömer",
  "kind": "fact",
  "side": "left"
 },
 {
  "scene": 6,
  "anchor": "Sonra yavruları ağzında, dil ve damak",
  "text": "Yavruları ağzında\nnasıl taşıyor?",
  "kind": "hook",
  "side": "right"
 },
 {
  "scene": 6,
  "anchor": "Yaklaşık üç, dört ay sonra, kurbağacık evresini",
