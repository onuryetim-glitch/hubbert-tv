  "kind": "fact",
  "side": "right"
 },
 {
  "scene": 3,
  "anchor": "Peki konak neden hâlâ besliyor?",
  "text": "Konak neden\nhâlâ besliyor?",
  "kind": "hook",
  "side": "left"
 },
 {
  "scene": 4,
  "anchor": "Dişi tek bir yumurta bırakıyor;",
